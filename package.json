{
	"name": "n8n-nodes-crmcalls",
	"version": "0.1.1",
	"description": "CRMCalls node for n8n: create and update contacts, bulk-load them into the call center or straight into an auto-dial project, read calls and download their recordings, and read scenarios, call results, projects, custom fields, tags and users",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"crmcalls",
		"call center",
		"auto dialer",
		"autodialer",
		"telephony",
		"calls",
		"leads",
		"crm"
	],
	"license": "MIT",
	"homepage": "https://github.com/zenland-dev/n8n-nodes-crmcalls",
	"author": {
		"name": "zenland-dev",
		"email": "zenland.dev@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zenland-dev/n8n-nodes-crmcalls.git"
	},
	"bugs": {
		"url": "https://github.com/zenland-dev/n8n-nodes-crmcalls/issues"
	},
	"engines": {
		"node": ">=20.19"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier nodes credentials shared --write",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CrmCallsCcApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CrmCalls/CrmCalls.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.46.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "^19.0.4",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
